# Local dev: point at any Postgres instance
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/ticketflow_test
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000

# On Vercel: create a Postgres database from the Storage tab and "Connect"
# it to this project — Vercel injects POSTGRES_URL automatically, you only
# need to add JWT_SECRET yourself under Project Settings → Environment Variables.
